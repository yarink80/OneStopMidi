<UserControl x:Class="OneStopMidi.App.Controls.KaraokeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E1015" SizeChanged="OnSizeChanged">
    <Grid Margin="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="LinesPanel" VerticalAlignment="Center" />
        <TextBlock x:Name="NoLyricsText" Text="No lyrics in this song" Foreground="#6B7385" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Border Grid.Row="1" BorderBrush="#2C313D" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
            <TextBlock x:Name="ChordLine" FontFamily="Consolas, Cascadia Mono" Foreground="#7FD1FF" FontSize="22"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
