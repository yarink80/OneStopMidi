<Window x:Class="OneStopMidi.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About OneStopMidi" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12.5">
    <StackPanel Margin="20">
        <Image Source="/OneStopMidi;component/Assets/elie-avatar.png" Width="180" Height="180" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="TitleText" Text="OneStopMidi" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
        <TextBlock Text="A MIDI file player with playlists, mixer, karaoke view and fully remappable keys."
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DimTextBrush}" />
        <TextBlock Text="Press F1 (or Help → Keyboard shortcuts) for the list of keys."
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DimTextBrush}" Margin="0,8,0,0" />
        <TextBlock x:Name="EngineText" TextAlignment="Center" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="0,8,0,0" />
        <Button Content="OK" Width="90" IsDefault="True" IsCancel="True" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</Window>
