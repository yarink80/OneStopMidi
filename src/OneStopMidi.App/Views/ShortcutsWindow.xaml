<Window x:Class="OneStopMidi.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="620" Height="620" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Current key assignments. Change them in File → Settings → Keyboard. NumPad Enter and the main Enter key are separate keys." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Width="80" IsCancel="True" IsDefault="True" />
        </StackPanel>
        <ListView x:Name="ShortcutList">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,2" Foreground="#3060A0" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Command" Width="330" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Keys" Width="230" DisplayMemberBinding="{Binding Keys}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
