<Window x:Class="OneStopMidi.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search in playlists" Width="680" Height="460" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Search" Width="80" Margin="6,0,0,0" IsDefault="True" Click="Search_Click" />
            <CheckBox x:Name="IncludeRecentBox" DockPanel.Dock="Right" Content="Include Recently Played" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox x:Name="QueryBox" Padding="3" />
        </DockPanel>
        <TextBlock x:Name="ResultText" DockPanel.Dock="Top" Margin="0,8,0,4" Text="Type part of a file name and press Enter." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Go to song" Width="100" Click="Go_Click" Margin="0,0,8,0" />
            <Button Content="Close" Width="80" IsCancel="True" />
        </StackPanel>
        <ListView x:Name="Results" MouseDoubleClick="Results_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Playlist" Width="170" DisplayMemberBinding="{Binding Playlist}" />
                    <GridViewColumn Header="File" Width="200" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Folder" Width="260" DisplayMemberBinding="{Binding Folder}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
