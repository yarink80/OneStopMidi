<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(OneStopMidiTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>OneStopMidi</AssemblyName>
    <RootNamespace>OneStopMidi.App</RootNamespace>
    <ApplicationIcon>Assets\OneStopMidi.ico</ApplicationIcon>
    <StartupObject>OneStopMidi.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by tools/avatar/make_avatar.py -->
    <Resource Include="Assets\OneStopMidi.ico" />
    <Resource Include="Assets\elie-avatar.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneStopMidi.Core\OneStopMidi.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OneStopMidi.App.Tests" />
  </ItemGroup>
</Project>
